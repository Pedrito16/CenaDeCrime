MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 3326139174929822128}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 10acac97b6af7d44b837c5c36264723c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPC
  interactMessage: '<color=blue>[E]</color> ligar para o assassino

'
  useOutlineInChildrens: 1
  highOutline: 1
  outlineRenderers:
  - {fileID: 2155530634846509614}
  - {fileID: 6214049391236244895}
  - {fileID: 6057091990822640515}
  gameManager: {fileID: 0}
  dialogues:
  - dialogueName: Assassino
    npcName: Assassino
    lines:
    - "Al\xF4?? \xC9 a valentina?"
    onLinesEnd:
      m_PersistentCalls:
        m_Calls: []
  - dialogueName: "Detetive Alu\xEDsio"
    npcName: "Detetive Alu\xEDsio"
    lines:
    - "Por acaso voc\xEA \xE9 um assassino? Voc\xEA teria alguma rela\xE7\xE3o com
      o crime da Rua Azevedo?"
    onLinesEnd:
      m_PersistentCalls:
        m_Calls: []
  - dialogueName: Assassino
    npcName: Assassino
    lines:
    - "Ai meu parceiro quem \xE9 tu?? eu n\xE3o to envolvido com nada n\xE3o."
    onLinesEnd:
      m_PersistentCalls:
        m_Calls: []
  - dialogueName: "Alu\xEDsio"
    npcName: "Detetive Alu\xEDsio"
    lines:
    - "Sou o detetive Alu\xEDsio, e caso voc\xEA n\xE3o saiba estou gravando a chamada,
      e logo logo iremos saber onde voc\xEA est\xE1"
    onLinesEnd:
      m_PersistentCalls:
        m_Calls: []
  - dialogueName: "Detetive Alu\xEDsio"
    npcName: "Detetive Alu\xEDsio"
    lines:
    - "Ent\xE3o fa\xE7a o favor e come\xE7e a falar a sua rela\xE7\xE3o com os envolvidos,
      Valentina e seu marido."
    onLinesEnd:
      m_PersistentCalls:
        m_Calls: []
  - dialogueName: Assassino
    npcName: Assassino
    lines:
    - "Eu n\xE3o estou envolvido com nenhum caso da rua Azevedo, a Valentina encontrou
      meu n\xFAmero na dark web.\n"
    onLinesEnd:
      m_PersistentCalls:
        m_Calls: []
  - dialogueName: Assassino
    npcName: Assassino
    lines:
    - Ela pediu para que eu protegesse ela, ela teme que seu marido pode tramar algo
      contra ela.
    onLinesEnd:
      m_PersistentCalls:
        m_Calls: []
  - dialogueName: Assassino
    npcName: Assassino
    lines:
    - "\xC9 apenas isso que sei..."
    onLinesEnd:
      m_PersistentCalls:
        m_Calls: []
  - dialogueName: "Detetive Alu\xEDsio"
    npcName: "Detetive Alu\xEDsio"
    lines:
    - "Entendi... do mesmo jeito, voc\xEA ter\xE1 que vir conosco, estamos tentando
      desvendar um caso, n\xE3o tente fugir..."
    onLinesEnd:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 3326139174929822129}
          m_TargetAssemblyTypeName: NPC, Assembly-CSharp
          m_MethodName: set_enabled
          m_Mode: 6
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
        - m_Target: {fileID: 3326139174929822128}
          m_TargetAssemblyTypeName: UnityEngine.GameObject, UnityEngine
          m_MethodName: set_layer
          m_Mode: 3
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
  loopDialogueOnEnd: 0
