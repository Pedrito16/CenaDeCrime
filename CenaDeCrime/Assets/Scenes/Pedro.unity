  dialogues:
  - dialogueName: "Introdu\xE7\xE3o"
    npcName: Senhor Torre
    lines:
    - "Ol\xE1 eu sou o senhor torre"
    - porque existo?
    - "Corrente el\xE9trica \xE9 o fluxo ordenado de part\xEDculas carregadas (geralmente
      el\xE9trons) que atravessa um material condutor, como fios de cobre, quando
      h\xE1 uma diferen\xE7a de potencial el\xE9trico (tens\xE3o).\n"
  loopDialogueOnEnd: 1
  dialogueIndex: 0
  currentLineIndex: 0
  isOnDialogue: 0
