  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "        Voc\xEA prendeu a\n              Valentina.\n\n\n\nValentina est\xE1
    na cadeia agora, provavelmente sentenciada a alguns longos anos de cadeia. Ela
    vai poder sair um tempinho antes se concordar em se comportar na cadeia e cumprir
    favores.\n\n\nUma mulher sem problemas com a justi\xE7a, ficha e nome limpo.
    Vivia sua vida tranquilamente, levando seu trabalho de florista com gosto. Mas
    agora na cadeia o maximo que ela vai fazer \xE9 desenhar em algumas plantas em
    umas folhas de pap\xE9is velha.\n\n\nSeu marido provavelmente v\xE1 visitar ela
    de vez em nunca na cadeia, mas do jeito que ela conhece ele, ela acha que ele
    v\xE1 procurar uma mulher nova logo menos\n\n\n\n\n\n         <color=red>Final
    errado.</color>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 5c914313b16ff5641977d6f959a44ac0, type: 2}
  m_sharedMaterial: {fileID: -6208067954569776190, guid: 5c914313b16ff5641977d6f959a44ac0, type: 2}
